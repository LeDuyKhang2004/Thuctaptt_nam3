<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<html><head><meta name="viewport" content="width=device-width, initial-scale=1"><title>Cấu hình nghiệp vụ - LeaveFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head>
<body><jsp:include page="../../components/layout/header.jsp"/><div class="wrapper"><jsp:include page="../../components/layout/sidebar-admin.jsp"/>
<main class="content"><div class="page-heading"><div><span class="eyebrow">LeaveFlow • Enhanced</span><h1>Cấu hình nghiệp vụ</h1></div></div><div class="settings-grid">
<div class="card"><h2>Phân bổ phép năm</h2><p>Áp dụng theo từng tài khoản và năm.</p><form method="post" action="${pageContext.request.contextPath}/admin/balances"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><label>Nhân viên<select name="userId" required><c:forEach var="u" items="${users}"><option value="${u.id}"><c:out value="${u.fullName}"/></option></c:forEach></select></label><label>Năm<input name="year" type="number" value="${year}" required></label><label>Ngày phép<input name="days" type="number" value="12" min="0" max="365" required></label><button>Cấp / cập nhật</button></form></div>
<div class="card"><h2>Ngày nghỉ lễ</h2><p><a class="btn btn-secondary" href="${pageContext.request.contextPath}/admin/calendar">Mở lịch công ty để xem ngày nghỉ</a></p><form method="post" action="${pageContext.request.contextPath}/admin/holidays"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><label>Ngày<input name="date" type="date" required></label><label>Tên ngày lễ<input name="name" required></label><button>Thêm ngày lễ</button></form><ul><c:forEach var="h" items="${holidays}"><li>${h.date} — <c:out value="${h.name}"/><form method="post" action="${pageContext.request.contextPath}/admin/holidays/delete/${h.id}" style="display:inline"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><button class="btn btn-danger" type="submit">Xóa</button></form></li></c:forEach></ul></div>
<div class="card"><h2>Thêm phòng ban</h2><form method="post" action="${pageContext.request.contextPath}/admin/departments"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><label>Tên phòng ban<input name="name" required></label><button>Thêm</button></form>
<h3>Gán nhân viên vào phòng</h3><form method="post" action="${pageContext.request.contextPath}/admin/departments/assign"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><label>Nhân viên<select name="userId"><c:forEach var="u" items="${users}"><option value="${u.id}"><c:out value="${u.fullName}"/></option></c:forEach></select></label><label>Phòng ban<select name="departmentId"><c:forEach var="d" items="${departments}"><option value="${d.id}"><c:out value="${d.name}"/></option></c:forEach></select></label><button>Gán phòng</button></form></div>
<div class="card"><h2>Chỉ định trưởng phòng</h2><form method="post" action="${pageContext.request.contextPath}/admin/departments/manager"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><label>Phòng ban<select name="departmentId"><c:forEach var="d" items="${departments}"><option value="${d.id}"><c:out value="${d.name}"/></option></c:forEach></select></label><label>Nhân viên được chọn<select name="userId"><c:forEach var="u" items="${users}"><option value="${u.id}"><c:out value="${u.fullName}"/></option></c:forEach></select></label><button>Gán làm trưởng phòng</button></form><p>Trưởng phòng duyệt trước, Admin duyệt cuối cùng.</p></div></div></main></div></body></html>